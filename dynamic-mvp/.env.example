# ============================================================
# Issue 001 — Library Dynamic Vertical Slice (local MVP)
# 复制为 .env 后填写本地值。.env 本身不入库（见 .gitignore）
#
# 安全约定：本文件只提供**占位符**，不含任何真实凭据。
#           真实值写在未跟踪的 .env 中，由脚本通过环境变量读取。
# ============================================================

# ---------- PostgreSQL ----------
DB_DATABASE=glp_mvp
DB_USER=glp
DB_PASSWORD=<set-in-local-.env>

# 宿主机映射端口（仅为本地调试，禁止公网暴露）
POSTGRES_HOST_PORT=55432

# ---------- Directus ----------
# KEY/SECRET：本地开发用随机字符串即可（SECRET 建议 ≥32 字符）
DIRECTUS_KEY=<random-string>
DIRECTUS_SECRET=<random-string-at-least-32-chars>

# 管理员（仅本地）
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=<set-in-local-.env>
DIRECTUS_HOST_PORT=8055

# ---------- Issue 001 最小写入通道（仅 AC2 用） ----------
# 一个专用静态 token，权限仅限 library 的 read / update（限定字段）
DIRECTUS_SLICE_WRITER_TOKEN=<set-in-local-.env>
